# Domínio final do site (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.exemplo.com.br

# Grupo do Clube — cadastro antes de liberar o convite
# Projeto Supabase (Settings → API). A chave é SECRETA: só no servidor/Vercel,
# nunca com prefixo NEXT_PUBLIC_.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Convite do grupo (https://chat.whatsapp.com/...). Só é enviado ao navegador
# depois de um cadastro válido.
CLUBE_GRUPO_URL=
# Sal para o hash do IP (qualquer texto longo e aleatório)
IP_HASH_SALT=
